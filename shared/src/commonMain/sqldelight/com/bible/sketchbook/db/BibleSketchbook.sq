CREATE TABLE bible_book (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    testament TEXT NOT NULL CHECK (testament IN ('OLD', 'NEW')),
    book_order INTEGER NOT NULL UNIQUE
);

CREATE TABLE bible_verse (
    book_id INTEGER NOT NULL,
    chapter INTEGER NOT NULL CHECK (chapter > 0),
    verse INTEGER NOT NULL CHECK (verse > 0),
    text TEXT NOT NULL,
    PRIMARY KEY (book_id, chapter, verse),
    FOREIGN KEY (book_id) REFERENCES bible_book(id) ON DELETE CASCADE
);

CREATE TABLE sketchbook (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT,
    cover_style TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE memory_card (
    id TEXT NOT NULL PRIMARY KEY,
    sketchbook_id TEXT NOT NULL,
    book_id INTEGER NOT NULL,
    chapter INTEGER NOT NULL CHECK (chapter > 0),
    start_verse INTEGER NOT NULL CHECK (start_verse > 0),
    end_verse INTEGER NOT NULL CHECK (end_verse >= start_verse),
    interval_days INTEGER NOT NULL DEFAULT 0 CHECK (interval_days >= 0),
    repetition_count INTEGER NOT NULL DEFAULT 0 CHECK (repetition_count >= 0),
    easiness_factor REAL NOT NULL DEFAULT 2.5 CHECK (easiness_factor >= 1.3),
    next_review_at INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    FOREIGN KEY (sketchbook_id) REFERENCES sketchbook(id) ON DELETE CASCADE,
    FOREIGN KEY (book_id, chapter, start_verse)
        REFERENCES bible_verse(book_id, chapter, verse),
    FOREIGN KEY (book_id, chapter, end_verse)
        REFERENCES bible_verse(book_id, chapter, verse)
);

CREATE TABLE review_history (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    card_id TEXT NOT NULL,
    rating TEXT NOT NULL CHECK (rating IN ('AGAIN', 'HARD', 'GOOD', 'EASY')),
    reviewed_at INTEGER NOT NULL,
    interval_days INTEGER NOT NULL CHECK (interval_days >= 0),
    easiness_factor REAL NOT NULL CHECK (easiness_factor >= 1.3),
    FOREIGN KEY (card_id) REFERENCES memory_card(id) ON DELETE CASCADE
);

selectDueCards:
SELECT *
FROM memory_card
WHERE next_review_at <= :now
ORDER BY next_review_at;

selectSketchbooks:
SELECT
    sketchbook.id,
    sketchbook.title,
    sketchbook.description,
    sketchbook.cover_style,
    sketchbook.created_at,
    (
        SELECT COUNT(*)
        FROM memory_card
        WHERE memory_card.sketchbook_id = sketchbook.id
          AND memory_card.next_review_at <= :now
    ) AS due_card_count
FROM sketchbook
ORDER BY sketchbook.created_at DESC;

selectCardsForSketchbook:
SELECT
    memory_card.id,
    memory_card.sketchbook_id,
    memory_card.book_id,
    memory_card.chapter,
    memory_card.start_verse,
    memory_card.end_verse,
    memory_card.interval_days,
    memory_card.repetition_count,
    memory_card.easiness_factor,
    memory_card.next_review_at,
    memory_card.created_at,
    bible_book.name AS book_name
FROM memory_card
JOIN bible_book ON bible_book.id = memory_card.book_id
WHERE memory_card.sketchbook_id = :sketchbook_id
ORDER BY memory_card.next_review_at, bible_book.book_order, memory_card.chapter;

selectDueCardCountForSketchbook:
SELECT COUNT(*)
FROM memory_card
WHERE sketchbook_id = :sketchbook_id
  AND next_review_at <= :now;

searchBibleVerses:
SELECT
    bible_verse.book_id,
    bible_book.name AS book_name,
    bible_verse.chapter,
    bible_verse.verse,
    bible_verse.text
FROM bible_verse
JOIN bible_book ON bible_book.id = bible_verse.book_id
WHERE (
      :chapter_filter IS NOT NULL
      AND (
          bible_book.name = :book_search COLLATE NOCASE
          OR bible_book.name LIKE :book_search || '%' COLLATE NOCASE
      )
      AND bible_verse.chapter = :chapter_filter
      AND (:verse_filter IS NULL OR bible_verse.verse = :verse_filter)
  )
  OR (
      :chapter_filter IS NULL
      AND (
          :text_search = ''
          OR bible_book.name LIKE '%' || :text_search || '%' COLLATE NOCASE
          OR bible_verse.text LIKE '%' || :text_search || '%' COLLATE NOCASE
      )
  )
ORDER BY bible_book.book_order, bible_verse.chapter, bible_verse.verse
LIMIT 60;

selectVersesForCard:
SELECT bible_verse.*
FROM bible_verse
JOIN memory_card
  ON bible_verse.book_id = memory_card.book_id
 AND bible_verse.chapter = memory_card.chapter
WHERE memory_card.id = :card_id
  AND bible_verse.verse BETWEEN memory_card.start_verse AND memory_card.end_verse
ORDER BY bible_verse.verse;

selectBibleVerseCount:
SELECT COUNT(*)
FROM bible_verse;

selectSketchbookCount:
SELECT COUNT(*)
FROM sketchbook;

insertBibleBook:
INSERT INTO bible_book (id, name, testament, book_order)
VALUES (:id, :name, :testament, :book_order);

insertBibleVerse:
INSERT INTO bible_verse (book_id, chapter, verse, text)
VALUES (:book_id, :chapter, :verse, :text);

insertSketchbook:
INSERT INTO sketchbook (id, title, description, cover_style, created_at)
VALUES (:id, :title, :description, :cover_style, :created_at);

insertMemoryCard:
INSERT OR IGNORE INTO memory_card (
    id,
    sketchbook_id,
    book_id,
    chapter,
    start_verse,
    end_verse,
    created_at
)
VALUES (
    :id,
    :sketchbook_id,
    :book_id,
    :chapter,
    :start_verse,
    :end_verse,
    :created_at
);

recordReview:
INSERT INTO review_history (
    card_id,
    rating,
    reviewed_at,
    interval_days,
    easiness_factor
)
VALUES (
    :card_id,
    :rating,
    :reviewed_at,
    :interval_days,
    :easiness_factor
);

updateMemoryCardSchedule:
UPDATE memory_card
SET interval_days = :interval_days,
    repetition_count = :repetition_count,
    easiness_factor = :easiness_factor,
    next_review_at = :next_review_at
WHERE id = :id;
